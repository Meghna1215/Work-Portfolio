---
// Full-screen image viewer. Put ONE <Lightbox /> on a page, anywhere inside <body>.
// Any button with a  data-full="<image url>"  attribute (see FullImage.astro) opens it.
//
// It closes with:  Esc · Backspace · the ✕ button · clicking anywhere · the browser Back button
---

<dialog id="lightbox" class="lightbox" data-lenis-prevent aria-label="Full image view">
  <button type="button" class="lightbox-close" aria-label="Close full image">✕</button>
  <img id="lightbox-img" alt="" />
  <p class="lightbox-hint">Press Esc or Backspace to close</p>
</dialog>

<style is:global>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #e6e0d6;
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgba(10, 11, 14, .94);
    backdrop-filter: blur(6px);
  }

  .lightbox img {
    display: block;
    max-width: min(96vw, 2600px);
    max-height: 88vh;
    max-height: 88dvh;
    object-fit: contain;
    background: #fff;
    cursor: zoom-out;
  }

  .lightbox-close {
    position: fixed;
    top: 18px;
    right: 22px;
    z-index: 2;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(230, 224, 214, .5);
    border-radius: 50%;
    background: rgba(18, 18, 18, .6);
    color: #e6e0d6;
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background .25s ease, color .25s ease;
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    background: #e6e0d6;
    color: #121212;
  }

  .lightbox-hint {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 14px;
    margin: 0;
    text-align: center;
    font-size: .72rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(230, 224, 214, .6);
    pointer-events: none;
  }

  /* stop the page scrolling behind the viewer */
  html.lightbox-open { overflow: hidden; }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  const bigImg = document.querySelector<HTMLImageElement>("#lightbox-img");

  if (dialog && bigImg) {
    const root = document.documentElement;
    let lastFocus: HTMLElement | null = null;

    // ---- open ----
    const open = (src: string, alt: string) => {
      lastFocus = document.activeElement as HTMLElement | null;
      bigImg.src = src;
      bigImg.alt = alt;
      root.classList.add("lightbox-open");
      dialog.showModal();
      // one history step, so the browser Back button closes the viewer
      // instead of leaving the page
      history.pushState({ lightbox: true }, "");
    };

    // ---- close (every route ends up in the dialog's "close" event) ----
    const close = () => {
      if (dialog.open) dialog.close();
    };

    dialog.addEventListener("close", () => {
      root.classList.remove("lightbox-open");
      bigImg.removeAttribute("src");
      lastFocus?.focus?.();
      // remove the history step we added when opening
      if (history.state && history.state.lightbox) history.back();
    });

    // browser Back button
    window.addEventListener("popstate", close);

    // click on any "View full image" button
    document.addEventListener("click", (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLElement>("[data-full]");
      if (btn) open(btn.dataset.full || "", btn.dataset.alt || "");
    });

    // click anywhere inside the viewer (image, backdrop or ✕) closes it
    dialog.addEventListener("click", close);

    // Esc and Backspace
    document.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      if (event.key === "Escape" || event.key === "Backspace") {
        event.preventDefault();
        close();
      }
    });
  }
</script>