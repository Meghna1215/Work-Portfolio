---
import "../styles/global.css";
import FullImage from "../components/FullImage.astro";
import Lightbox from "../components/Lightbox.astro";

// Works whether your configured base ends with a slash or not.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ------------------------------------------------------------
// PHOTOS: files inside  public/Coordinate/
// File names must match exactly (including capitals and spaces).
// ------------------------------------------------------------
const img = (file: string) => encodeURI(`${base}/Coordinate/${file}`);

// ------------------------------------------------------------
// PAGE CONTENT: edit freely
// ------------------------------------------------------------
const title = "Coordinate";
const tag = "BIM Coordination & Clash Detection";
const headline = "From multidisciplinary test to verified model resolution.";
const intro =
  "A clear coordination story focused on how clashes are detected, understood and corrected.";

// One section per step (scroll 2 onwards).
// `images` can hold one or more pictures; with two or more they are stacked
// one under the other and the text stays in view while you scroll past them.
const steps = [
  {
    number: "01",
    heading: "Combine Models",
    text: "Bring architectural, structural, and building services models together for multidisciplinary coordination.",
    images: [
      { src: img("Combine Models.png"), alt: "Architectural, structural and services models combined in one federated model" }
    ]
  },
  {
    number: "02",
    heading: "Run Clash Test",
    text: "Perform clash detection in Navisworks to identify conflicts between different disciplines.",
    images: [
      { src: img("Running a clash.png"), alt: "Navisworks Clash Detective: setting up and running a clash test" }
    ]
  },
  {
    number: "03",
    heading: "Review Clashes",
    text: "Examine detected clashes to identify affected elements and determine the necessary action.",
    images: [
      { src: img("Clash Detection.png"), alt: "Navisworks Clash Detective: clash results highlighted in the model" },
      { src: img("Review Clashes.png"), alt: "Reviewing an individual clash and the elements affected" }
    ]
  },
  {
    number: "04",
    heading: "Resolve Internally",
    text: "Make necessary model adjustments to resolve clashes within my scope of work.",
    images: [
      { src: img("Resolving a clash.png"), alt: "Navisworks Clash Detective: clashes resolved after correcting the model" }
    ]
  },
  {
    number: "05",
    heading: "Share Report",
    text: "Document and share unresolved clashes with the respective contractors for further coordination and correction.",
    images: [
      { src: img("Report Sharing.png"), alt: "Clash report prepared to share with the contractors" }
    ]
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="BIM coordination and clash detection: test, identify and resolve."
    />
    <meta name="theme-color" content="#6B6F4E" />
    <title>{title} — Meghna Jayanarayanan</title>
  </head>

  <body>

    <!-- HEADER -->
    <header class="site-header">
      <a class="brand" href={`${base}/#home`} aria-label="Go to home">
        <span>MJ<span class="dot">.</span></span>
      </a>

      <a class="back-link" href={`${base}/#skills-coordinate`}>
        <span aria-hidden="true">←</span> Back to Skills
      </a>
    </header>


    <main class="coordinate-page">

      <!-- ===== SCROLL 1: full-screen green title ===== -->
      <section class="coord-hero">
        <div class="coord-hero-inner">
          <div class="coord-hero-main">
            <h1>{title}</h1>
            <h2>{headline}</h2>
            <p>{intro}</p>
          </div>

          <p class="coord-tag">{tag}</p>
        </div>
      </section>


      <!-- ===== SCROLL 2-6: the five coordination steps ===== -->
      {steps.map((step) => (
        <section class:list={["coord-step", step.images.length > 1 && "coord-step--multi"]}>
          <div class="step-text">
            <span class="step-number">{step.number}</span>
            <h2>{step.heading}</h2>
            <p>{step.text}</p>
          </div>

          <div class="step-figures">
            {step.images.map((image) => (
              <FullImage class="step-figure" src={image.src} alt={image.alt} />
            ))}
          </div>
        </section>
      ))}

    </main>


    <!-- FOOTER -->
    <footer>
      <span>MJ / Portfolio</span>
      <span>Built with intention.</span>
    </footer>


    <Lightbox />


    <script>
      import Lenis from "lenis";

      // ==========================================
      // SMOOTH SCROLLING (same settings as the home page)
      // ==========================================

      const reduceMotion =
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        new Lenis({
          autoRaf: true,
          lerp: 0.08,
          wheelMultiplier: 0.8,
          anchors: true
        });
      }
    </script>

  </body>
</html>

<style is:global>
  body {
    background: var(--graphite);
  }

  /* ---------- header back link ---------- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--bone);
    opacity: .86;
    transition: opacity .25s ease, color .25s ease, gap .25s ease;
  }

  .back-link:hover {
    color: #fff;
    opacity: 1;
    gap: 14px;
    text-shadow:
      0 0 8px rgba(200, 155, 74, 0.8),
      0 0 16px rgba(200, 155, 74, 0.5);
  }

  /* ---------- SCROLL 1: full-screen green hero ---------- */
  .coord-hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding:
      calc(var(--header-height) + 24px)
      clamp(24px, 6vw, 90px)
      60px;
    background: var(--olive);
    color: var(--bone);
  }

  .coord-hero-inner {
    width: min(1400px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(150px, 260px);
    column-gap: clamp(16px, 3vw, 48px);
    align-items: start;
  }

  .coord-hero-main h1 {
    margin: 0;
    font-family: "DM Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(3.6rem, 11vw, 9.5rem);
    line-height: .95;
    letter-spacing: -.06em;
    color: var(--bone);
  }

  .coord-hero-main h2 {
    margin: clamp(10px, 2vw, 26px) 0 18px;
    max-width: 26em;
    font-family: "DM Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.7rem, 3.9vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: var(--bone);
  }

  .coord-hero-main p {
    margin: 0;
    max-width: 34em;
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgba(230, 224, 214, .8);
  }

  .coord-tag {
    margin: 0;
    padding-top: 0;
    text-align: right;
    font-size: .85rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(230, 224, 214, .8);
  }

  /* ---------- SCROLL 2-6: steps ---------- */
  .coord-step {
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(0, 2.4fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
    padding:
      calc(var(--header-height) + 16px)
      clamp(24px, 6vw, 90px)
      40px;
    border-top: 1px solid var(--line);
  }

  .step-text { max-width: 26em; min-width: 0; }

  /* stack of one or more pictures */
  .step-figures {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 36px);
    min-width: 0;
  }

  /* a step with 2+ pictures is taller than the screen: line the text up with
     the first picture and keep it in view while you scroll past them */
  .coord-step--multi { align-items: start; }

  .coord-step--multi .step-text {
    position: sticky;
    top: calc(var(--header-height) + 24px);
  }

  .step-number {
    display: block;
    margin-bottom: 18px;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: .06em;
    color: var(--gold);
  }

  .step-text h2 {
    margin: 0 0 24px;
    font-family: "DM Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 3.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -.04em;
    text-transform: uppercase;
    overflow-wrap: break-word;
    color: var(--bone);
  }

  .step-text p {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .step-figure {
    position: relative;
    margin: 0;
    background: #fff;
  }

  .step-figure img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100svh - var(--header-height) - 70px);
    object-fit: contain;
    object-position: center;
    background: #1b1d22;
  }

  /* ---------- small screens ---------- */
  @media (max-width: 900px) {
    .coord-hero-inner {
      grid-template-columns: 1fr;
      row-gap: 18px;
    }

    .coord-tag { text-align: left; }

    .coord-step {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: calc(var(--header-height) + 28px);
      padding-bottom: 56px;
      gap: 28px;
    }

    .step-figure img { max-height: none; }

    .coord-step--multi .step-text { position: static; }
  }
</style>