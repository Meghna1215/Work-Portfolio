---
import "../styles/global.css";

// Works whether your configured base ends with a slash or not.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ------------------------------------------------------------
// YOUR 3D FILE: put it at  public/models/model.glb
// (or change this path to wherever your .glb lives)
// ------------------------------------------------------------
const modelUrl = `${base}/models/model.glb`;

// ------------------------------------------------------------
// PHOTOS: files inside  public/Model/
// File names must match exactly (including capitals and spaces).
// ------------------------------------------------------------
const img = (file: string) => encodeURI(`${base}/Model/${file}`);

// ------------------------------------------------------------
// PAGE CONTENT: edit freely
// ------------------------------------------------------------
const title = "Model";

const intro =
  "An interactive look at a typical elevated metro station at the concourse level. Modelling is where every project starts: turning design intent into accurate, coordinated geometry and data that the whole team can rely on.";

// Cards under "Additional modelling work".
//  - `wide: true`  -> card spans the full row
//  - `images`      -> 1 or 2 photos (first one is shown larger)
const projects = [
  {
    title: "Steel Bridge",
    text: "A coordinated Revit model of a multi-span steel truss bridge and its supporting substructure.",
    wide: true,
    images: [
      { src: img("STEEL BRIDGE - BIM 360 - 2.png"), alt: "Steel Bridge BIM model" }
    ]
  },
  {
    title: "Twin Tunnel",
    text: "A parametric tunnel-ring family developed in Revit and applied across a typical twin-tunnel model.",
    wide: false,
    images: [
      { src: img("TBM TWIN TUNNEL.png"), alt: "Twin Tunnel BIM model" },
      { src: img("TBM TUNNEL RING.png"), alt: "Twin Tunnel ring detail" }
    ]
  },
  {
    title: "Viaduct",
    text: "A detailed Revit model of a curved elevated viaduct, including piers, pier caps and foundations.",
    wide: false,
    images: [
      { src: img("VIADUCT - BIM 360 - 1.png"), alt: "Viaduct BIM model" },
      { src: img("VIADUCT - BIM 360 - 2.png"), alt: "Viaduct detail" }
    ]
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Interactive BIM model and selected infrastructure modelling work."
    />
    <meta name="theme-color" content="#17191e" />
    <title>{title} — Meghna Jayanarayanan</title>
  </head>

  <body>

    <!-- HEADER -->
    <header class="site-header">
      <a class="brand" href={`${base}/#home`} aria-label="Go to home">
        <span>MJ<span class="dot">.</span></span>
      </a>

      <a class="back-link" href={`${base}/#skills`}>
        <span aria-hidden="true">←</span> Back to Skills
      </a>
    </header>


    <main class="model-page">

      <!-- ===== HERO: title + interactive model ===== -->
      <section class="model-hero">

        <div class="info">
          <h1>{title}</h1>
          <p class="intro">{intro}</p>
        </div>

        <div class="stage" aria-label="Interactive 3D model">

          <!-- 3D VIEWER (loads automatically) -->
          <div class="stage-viewer">

            <model-viewer
              id="viewer"
              data-lenis-prevent
              src={modelUrl}
              alt="Interactive 3D BIM model"
              camera-controls
              environment-image="neutral"
              exposure="1.1"
              shadow-intensity="0.9"
              shadow-softness="1"
              min-camera-orbit="auto auto 10%"
              max-camera-orbit="auto auto 400%"
              interaction-prompt="none"
            ></model-viewer>

            <div class="viewer-toolbar">
              <button type="button" id="btn-reset">Reset view</button>
              <button type="button" id="btn-rotate" aria-pressed="false">Auto-rotate</button>
            </div>

            <p class="viewer-hint">
              <span class="hint-mouse">Drag to rotate · Scroll to zoom · Right-click or Shift + drag to pan</span>
              <span class="hint-touch">Drag to rotate · Pinch to zoom · Two fingers to pan</span>
            </p>

            <div class="viewer-loading" id="loading" role="status">
              <div class="bar"><span id="bar-fill"></span></div>
              <small id="loading-text">Loading model…</small>
            </div>

            <div class="viewer-error" id="error" hidden>
              <strong>Couldn't load the 3D model.</strong>
              <span>Check that your file is at <code>public/models/model.glb</code>.</span>
            </div>

          </div>
        </div>

      </section>


      <!-- ===== SELECTED MODELS ===== -->
      <section class="selected">
        <h2 class="selected-title">Additional modelling work</h2>

        <div class="project-grid">
          {projects.map((p) => (
            <article class:list={["project-card", p.wide && "project-card--wide"]}>
              <div class:list={["project-images", p.images.length > 1 && "project-images--pair"]}>
                {p.images.map((image) => (
                  <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                ))}
              </div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))}
        </div>
      </section>

    </main>


    <!-- FOOTER -->
    <footer>
      <span>MJ / Portfolio</span>
      <span>Built with intention.</span>
    </footer>


    <script>
      import "@google/model-viewer";
      import Lenis from "lenis";

      // ==========================================
      // SMOOTH SCROLLING (same settings as the home page)
      // ------------------------------------------
      // lerp: lower = smoother / floatier (0.05 – 0.15 is the useful range)
      // wheelMultiplier: lower = each wheel notch scrolls less distance
      // Touch screens keep their native scrolling.
      // ==========================================

      const reduceMotion =
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        new Lenis({
          autoRaf: true,
          lerp: 0.08,
          wheelMultiplier: 0.8,
          anchors: true
        });
      }

      const viewer = document.querySelector("#viewer");
      const loading = document.querySelector("#loading");
      const fill = document.querySelector("#bar-fill");
      const loadingText = document.querySelector("#loading-text");
      const errorBox = document.querySelector("#error");
      const resetBtn = document.querySelector("#btn-reset");
      const rotateBtn = document.querySelector("#btn-rotate");

      // ---- loading progress ----
      viewer.addEventListener("progress", (event) => {
        const pct = Math.round((event.detail.totalProgress || 0) * 100);
        fill.style.width = `${pct}%`;
        loadingText.textContent = `Loading model… ${pct}%`;
      });

      viewer.addEventListener("load", () => loading.classList.add("done"));

      viewer.addEventListener("error", () => {
        loading.classList.add("done");
        errorBox.hidden = false;
      });

      // ---- reset view: back to the automatic framing ----
      resetBtn.addEventListener("click", () => {
        viewer.cameraTarget = "auto auto auto";
        viewer.cameraOrbit = "auto auto auto";
        viewer.fieldOfView = "auto";
        viewer.jumpCameraToGoal();
      });

      // ---- auto-rotate toggle ----
      rotateBtn.addEventListener("click", () => {
        viewer.autoRotate = !viewer.autoRotate;
        rotateBtn.setAttribute("aria-pressed", String(viewer.autoRotate));
      });
    </script>

  </body>
</html>

<style is:global>
  body {
    background: var(--graphite);
  }

  /* ---------- header back link ---------- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--bone);
    opacity: .86;
    transition: opacity .25s ease, color .25s ease, gap .25s ease;
  }

  .back-link:hover {
    color: #fff;
    opacity: 1;
    gap: 14px;
    text-shadow:
      0 0 8px rgba(200, 155, 74, 0.8),
      0 0 16px rgba(200, 155, 74, 0.5);
  }

  /* ---------- page ---------- */
  .model-page {
    padding:
      calc(var(--header-height) + 16px)
      clamp(16px, 5vw, 90px)
      90px;
  }

  .model-hero,
  .selected {
    width: min(1300px, 100%);
    margin: 0 auto;
  }

  /* ---------- hero ---------- */
  .model-hero {
    min-height: calc(100svh - var(--header-height) - 40px);
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 2fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
  }

  .info h1 {
    margin: 0 0 28px;
    font-family: "DM Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(3.4rem, 7vw, 6.4rem);
    line-height: 1;
    letter-spacing: -.055em;
    color: var(--bone);
  }

  .intro {
    margin: 0;
    max-width: 30em;
    font-size: 1.12rem;
    line-height: 1.85;
    color: var(--muted);
  }

  /* ---------- 3D stage ---------- */
  .stage {
    position: relative;
    height: clamp(420px, calc(100svh - var(--header-height) - 100px), 660px);
    overflow: hidden;
    border: 1px solid rgba(230, 224, 214, .3);
    border-radius: 26px;
    background:
      radial-gradient(circle at 50% 30%, #2b303a 0%, #191c22 62%, #121212 100%);
  }

  /* viewer */
  .stage-viewer { position: absolute; inset: 0; }

  model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    --poster-color: transparent;
    --progress-bar-color: transparent;   /* we draw our own bar */
    outline: none;
    cursor: grab;
  }

  model-viewer:active { cursor: grabbing; }

  .viewer-toolbar {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .viewer-toolbar button {
    padding: 9px 16px;
    border: 1px solid rgba(230, 224, 214, .45);
    border-radius: 999px;
    background: rgba(18, 18, 18, .55);
    backdrop-filter: blur(6px);
    color: var(--bone);
    font: inherit;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }

  .viewer-toolbar button:hover {
    background: var(--bone);
    color: var(--graphite);
    border-color: var(--bone);
  }

  .viewer-toolbar button[aria-pressed="true"] {
    border-color: var(--gold);
    color: var(--gold);
  }

  .viewer-toolbar button[aria-pressed="true"]:hover {
    background: var(--gold);
    color: var(--graphite);
  }

  .viewer-hint {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 16px;
    margin: 0;
    z-index: 2;
    pointer-events: none;
    font-size: .72rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hint-touch { display: none; }

  @media (hover: none) {
    .hint-mouse { display: none; }
    .hint-touch { display: inline; }
  }

  .viewer-loading {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    background: #121212;
    transition: opacity .5s ease, visibility .5s ease;
  }

  .viewer-loading.done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .viewer-loading .bar {
    width: min(260px, 60vw);
    height: 3px;
    background: var(--line);
    border-radius: 3px;
    overflow: hidden;
  }

  .viewer-loading .bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--gold);
    transition: width .2s ease;
  }

  .viewer-loading small {
    color: var(--muted);
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .viewer-error {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    padding: 24px;
    text-align: center;
    background: #121212;
    color: var(--bone);
  }

  .viewer-error[hidden] { display: none; }
  .viewer-error span { color: var(--muted); font-size: .9rem; }

  .viewer-error code {
    padding: 2px 8px;
    border-radius: 6px;
    background: rgba(230, 224, 214, .1);
  }

  /* ---------- selected models ---------- */
  .selected { padding-top: clamp(48px, 8vw, 110px); }

  .selected-title {
    margin: 0 0 36px;
    font-family: "DM Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 4.6vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -.045em;
    color: var(--bone);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .project-card {
    padding: 16px 16px 26px;
    border: 1px solid rgba(230, 224, 214, .18);
    background: #1c1f26;
  }

  .project-card--wide { grid-column: 1 / -1; }

  .project-images {
    display: flex;
    gap: 13px;
    margin-bottom: 26px;
  }

  .project-images img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #e9e6df;
  }

  /* single wide photo */
  .project-card--wide .project-images { aspect-ratio: 16 / 7; }

  /* two photos: first is larger, second is narrower */
  .project-images--pair { height: clamp(200px, 22vw, 313px); }
  .project-images--pair img:first-child { flex: 1.8 1 0; min-width: 0; }
  .project-images--pair img:last-child  { flex: 1 1 0;   min-width: 0; }

  .project-card h3 {
    margin: 0 10px 10px;
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--bone);
  }

  .project-card p {
    margin: 0 10px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* ---------- small screens ---------- */
  @media (max-width: 900px) {
    .model-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 24px;
    }

    .stage { height: clamp(340px, 56svh, 520px); border-radius: 20px; }
  }

  @media (max-width: 760px) {
    .project-grid { grid-template-columns: 1fr; }
    .project-card--wide .project-images { aspect-ratio: 16 / 9; }
    .project-images--pair { height: clamp(150px, 42vw, 240px); }
  }
</style>