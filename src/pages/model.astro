---
import "../styles/global.css";

// Works whether your configured base ends with a slash or not.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ------------------------------------------------------------
// YOUR 3D FILE: put it at  public/models/model.glb
// (or change this path to wherever your .glb lives)
// ------------------------------------------------------------
const modelUrl = `${base}/models/model.glb`;

// ------------------------------------------------------------
// PAGE CONTENT: edit freely
// ------------------------------------------------------------
const title = "Model";
const eyebrow = "01 — Skill";

const lead =
  "An interactive look at a BIM model, exported from the authoring software and opened right here in the browser.";

const body = [
  "Modelling is where every project starts: turning design intent into accurate, coordinated geometry and data that the whole team can rely on.",
  "Use the viewer to orbit around the model, zoom into the details and pan across it to inspect it from any angle."
];

const details = [
  { label: "Discipline", value: "BIM / Infrastructure" },
  { label: "Software", value: "Revit" },
  { label: "Format", value: "glTF Binary (.glb)" },
  { label: "Role", value: "BIM Architect & Coordinator" }
];

const highlights = [
  "Coordinated, data-rich model built for multidisciplinary delivery",
  "Clean element organisation and naming for easy review",
  "Exported to glTF so anyone can explore it without special software"
];

const controls = [
  { action: "Rotate", how: "Drag with the mouse, or one finger" },
  { action: "Zoom", how: "Scroll wheel, or pinch" },
  { action: "Pan", how: "Right-click drag, Shift + drag, or two fingers" }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="An interactive 3D BIM model you can rotate, pan and zoom."
    />
    <title>{title} — Meghna Jayanarayanan</title>
  </head>

  <body>

    <!-- HEADER -->
    <header class="site-header">
      <a class="brand" href={`${base}/#home`} aria-label="Go to home">
        <span>MJ<span class="dot">.</span></span>
      </a>

      <a class="back-link" href={`${base}/#skills`}>
        <span aria-hidden="true">←</span> Back to Skills
      </a>
    </header>


    <main class="model-page">

      <div class="model-layout">

        <!-- 3D VIEWER -->
        <section class="viewer-card" aria-label="Interactive 3D model">

          <model-viewer
            id="viewer"
            src={modelUrl}
            alt="Interactive 3D BIM model"
            camera-controls
            environment-image="neutral"
            exposure="1.1"
            shadow-intensity="0.9"
            shadow-softness="1"
            min-camera-orbit="auto auto 10%"
            max-camera-orbit="auto auto 400%"
            interaction-prompt="none"
            loading="eager"
          ></model-viewer>

          <div class="viewer-toolbar">
            <button type="button" id="btn-reset">Reset view</button>
            <button type="button" id="btn-rotate" aria-pressed="false">Auto-rotate</button>
          </div>

          <p class="viewer-hint">
            <span class="hint-mouse">Drag to rotate · Scroll to zoom · Right-click or Shift + drag to pan</span>
            <span class="hint-touch">Drag to rotate · Pinch to zoom · Two fingers to pan</span>
          </p>

          <div class="viewer-loading" id="loading" role="status">
            <div class="bar"><span id="bar-fill"></span></div>
            <small id="loading-text">Loading model…</small>
          </div>

          <div class="viewer-error" id="error" hidden>
            <strong>Couldn't load the 3D model.</strong>
            <span>
              Check that your file is at <code>public/models/model.glb</code>.
            </span>
          </div>

        </section>


        <!-- DESCRIPTION -->
        <aside class="info">

          <p class="eyebrow">{eyebrow}</p>
          <h1>{title}</h1>

          <p class="lead">{lead}</p>

          {body.map((paragraph) => <p class="copy">{paragraph}</p>)}

          <dl class="details">
            {details.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>

          <h2 class="info-heading">Highlights</h2>
          <ul class="highlights">
            {highlights.map((item) => <li>{item}</li>)}
          </ul>

          <h2 class="info-heading">How to explore</h2>
          <ul class="controls-list">
            {controls.map((item) => (
              <li>
                <strong>{item.action}</strong>
                <span>{item.how}</span>
              </li>
            ))}
          </ul>

        </aside>

      </div>

    </main>


    <!-- FOOTER -->
    <footer>
      <span>MJ / Portfolio</span>
      <span>Built with intention.</span>
    </footer>


    <script>
      import "@google/model-viewer";

      const viewer = document.querySelector("#viewer") as any;
      const loading = document.querySelector("#loading") as HTMLElement;
      const fill = document.querySelector("#bar-fill") as HTMLElement;
      const loadingText = document.querySelector("#loading-text") as HTMLElement;
      const errorBox = document.querySelector("#error") as HTMLElement;
      const resetBtn = document.querySelector("#btn-reset") as HTMLButtonElement;
      const rotateBtn = document.querySelector("#btn-rotate") as HTMLButtonElement;

      // ---- loading progress ----
      viewer.addEventListener("progress", (event: any) => {
        const pct = Math.round((event.detail.totalProgress || 0) * 100);
        fill.style.width = `${pct}%`;
        loadingText.textContent = `Loading model… ${pct}%`;
      });

      viewer.addEventListener("load", () => {
        loading.classList.add("done");
      });

      viewer.addEventListener("error", () => {
        loading.classList.add("done");
        errorBox.hidden = false;
      });

      // ---- reset view: back to the automatic framing ----
      resetBtn.addEventListener("click", () => {
        viewer.cameraTarget = "auto auto auto";
        viewer.cameraOrbit = "auto auto auto";
        viewer.fieldOfView = "auto";
        viewer.jumpCameraToGoal();
      });

      // ---- auto-rotate toggle ----
      rotateBtn.addEventListener("click", () => {
        viewer.autoRotate = !viewer.autoRotate;
        rotateBtn.setAttribute("aria-pressed", String(viewer.autoRotate));
      });
    </script>

  </body>
</html>

<style>
  body {
    background: var(--graphite);
  }

  /* ---------- header back link ---------- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--bone);
    opacity: .86;
    transition: opacity .25s ease, color .25s ease, gap .25s ease;
  }

  .back-link:hover {
    color: #fff;
    opacity: 1;
    gap: 14px;
    text-shadow:
      0 0 8px rgba(200, 155, 74, 0.8),
      0 0 16px rgba(200, 155, 74, 0.5);
  }

  /* ---------- page layout ---------- */
  .model-page {
    min-height: 100svh;
    padding:
      calc(var(--header-height) + 16px)
      clamp(16px, 5vw, 80px)
      64px;
  }

  .model-layout {
    width: min(1300px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr);
    gap: clamp(24px, 3.5vw, 56px);
    align-items: start;
  }

  /* ---------- viewer ---------- */
  .viewer-card {
    position: relative;
    height: clamp(420px, calc(100svh - var(--header-height) - 100px), 820px);
    overflow: hidden;
    border: 1px solid rgba(230, 224, 214, .3);
    border-radius: 26px;
    background:
      radial-gradient(circle at 50% 30%, #2b303a 0%, #191c22 62%, #121212 100%);
  }

  model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    --poster-color: transparent;
    --progress-bar-color: transparent;   /* we draw our own bar */
    outline: none;
    cursor: grab;
  }

  model-viewer:active { cursor: grabbing; }

  .viewer-toolbar {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .viewer-toolbar button {
    padding: 9px 16px;
    border: 1px solid rgba(230, 224, 214, .45);
    border-radius: 999px;
    background: rgba(18, 18, 18, .55);
    backdrop-filter: blur(6px);
    color: var(--bone);
    font: inherit;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }

  .viewer-toolbar button:hover {
    background: var(--bone);
    color: var(--graphite);
    border-color: var(--bone);
  }

  .viewer-toolbar button[aria-pressed="true"] {
    border-color: var(--gold);
    color: var(--gold);
  }

  .viewer-toolbar button[aria-pressed="true"]:hover {
    background: var(--gold);
    color: var(--graphite);
  }

  .viewer-hint {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 16px;
    margin: 0;
    z-index: 2;
    pointer-events: none;
    font-size: .72rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hint-touch { display: none; }

  @media (hover: none) {
    .hint-mouse { display: none; }
    .hint-touch { display: inline; }
  }

  /* loading state */
  .viewer-loading {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    background: #121212;
    transition: opacity .5s ease, visibility .5s ease;
  }

  .viewer-loading.done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .viewer-loading .bar {
    width: min(260px, 60vw);
    height: 3px;
    background: var(--line);
    border-radius: 3px;
    overflow: hidden;
  }

  .viewer-loading .bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--gold);
    transition: width .2s ease;
  }

  .viewer-loading small {
    color: var(--muted);
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .viewer-error {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    padding: 24px;
    text-align: center;
    background: #121212;
    color: var(--bone);
  }

  .viewer-error[hidden] { display: none; }
  .viewer-error span { color: var(--muted); font-size: .9rem; }

  .viewer-error code {
    padding: 2px 8px;
    border-radius: 6px;
    background: rgba(230, 224, 214, .1);
  }

  /* ---------- description ---------- */
  .info h1 {
    margin: 0 0 22px;
    font-family: "DM Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -.055em;
    background: linear-gradient(180deg, #f4f4f4 10%, #8e939b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .lead {
    margin: 0 0 18px;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--bone);
  }

  .copy {
    margin: 0 0 16px;
    line-height: 1.7;
    color: var(--muted);
  }

  .details {
    margin: 30px 0 34px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
  }

  .details > div {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .details dt {
    margin: 0 0 6px;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .details dd {
    margin: 0;
    font-weight: 500;
    color: var(--bone);
  }

  .info-heading {
    margin: 0 0 14px;
    font-family: "Playfair Display", serif;
    font-size: .95rem;
    font-weight: 500;
    letter-spacing: .03em;
    color: var(--gold);
  }

  .highlights {
    margin: 0 0 34px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .highlights li {
    position: relative;
    padding-left: 22px;
    line-height: 1.55;
    color: var(--muted);
  }

  .highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .62em;
    width: 8px;
    height: 2px;
    background: var(--gold);
  }

  .controls-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .controls-list li {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: .9rem;
  }

  .controls-list strong { color: var(--bone); }
  .controls-list span { color: var(--muted); text-align: right; }

  /* ---------- small screens ---------- */
  @media (max-width: 900px) {
    .model-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .viewer-card {
      height: clamp(340px, 56svh, 560px);
      border-radius: 20px;
    }

    .viewer-hint { font-size: .64rem; }
  }

  @media (max-width: 680px) {
    .details { grid-template-columns: 1fr; }
    .controls-list li { flex-direction: column; gap: 4px; }
    .controls-list span { text-align: left; }
  }
</style>