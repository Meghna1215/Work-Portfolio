        <div class="section-heading">
          <h2>Skills</h2>
          <span class="scroll-hint">Scroll to explore</span>
        </div>

        <div class="stacked-cards-container">

          {skills.map((p, i) => {
            return (
              <article class="project-stack-card" style={`--i:${i}`}>

                <div class="project-stack-header">
                  <div class="project-info-left">
                    <span class="stack-num">{p.number}</span>
                    <div class="stack-titles">
                      <h3>{p.title}</h3>
                    </div>
                  </div>
                  <a class="live-project-btn" href={p.href}>View Project</a>
                </div>

                <p class="stack-text">{p.text}</p>

                <div class="stack-images-grid">
                  {[0, 1, 2].map((n) => (
                    <div class:list={["stack-img-box", n === 2 && "stack-img-box--large"]}>
                      {p.images[n]
                        ? <img src={p.images[n]} alt="" loading="lazy" />
                        : <Fragment set:html={p.visuals[n]} />}
                    </div>
                  ))}
                </div>

              </article>
            );
          })}

        </div>

        </div>

      </section>


      <!-- CONTACT -->
