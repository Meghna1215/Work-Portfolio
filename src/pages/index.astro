---
import "../styles/global.css";

const projects = [
  {
    number: "01",
    title: "Revit Automation",
    type: "BIM / API",
    text: "Automation tools for Revit workflows, geometry extraction, element processing and model-aware operations.",
    tag: "Revit API"
  },
  {
    number: "02",
    title: "Space Generation Engine",
    type: "Geometry / Algorithms",
    text: "A geometry pipeline for turning site boundaries into grids, intersections, cells and optimized usable spaces.",
    tag: "C# / Geometry"
  },
  {
    number: "03",
    title: "CAD Plugin Systems",
    type: "Plugin Development",
    text: "Desktop tooling designed around clean architecture, MVVM, reusable services and production CAD workflows.",
    tag: "AutoCAD / C#"
  },
  {
    number: "04",
    title: "Data & Automation",
    type: "Python / Tools",
    text: "Small automation systems connecting engineering data, files, calculations and repeatable design processes.",
    tag: "Python"
  }
];

const posts = [
  {
    date: "08.08.26",
    title: "Building geometry-first automation",
    category: "Engineering Notes",
    text: "Thoughts on converting messy CAD geometry into clean computational pipelines."
  },
  {
    date: "Coming soon",
    title: "Finding useful rectangles inside polygons",
    category: "Algorithms",
    text: "A visual look at grid generation, intersection graphs and interior-space searches."
  },
  {
    date: "Coming soon",
    title: "Designing plugin architecture",
    category: "Software Design",
    text: "How interfaces, services and ViewModels can keep a desktop plugin maintainable."
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal portfolio — BIM, CAD automation and software development." />
    <title>Your Name — Portfolio</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="#home" aria-label="Go to home">MJ</a>

      <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="desktop-nav" aria-label="Main navigation">
        <a class="nav-link active" href="#home">Home</a>
        <a class="nav-link" href="#works">Works</a>
        <a class="nav-link" href="#contact">Contact</a>
        <a class="nav-link" href="#blog">Blog</a>
      </nav>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a href="#home">Home</a>
        <a href="#works">Works</a>
        <a href="#contact">Contact</a>
        <a href="#blog">Blog</a>
      </nav>
    </header>

    <main>
      <!-- HOME -->
      <section id="home" class="section hero">
        <div class="hero-grid">
          <div class="hero-intro">
            <p class="eyebrow">Portfolio / 2026</p>
            <h1>Meghna<br />Jayanarayanan</h1>
            <div class="accent-line"></div>

            <div class="socials">
              <a href="#" aria-label="LinkedIn">in</a>
              <a href="#" aria-label="GitHub">github</a>
              <a href="#" class="cv-link">Download CV</a>
            </div>
          </div>

          <div class="portrait-frame">
            <div class="portrait-placeholder">
              <span>YOUR<br />IMAGE</span>
              <small>replace with portrait / profile image</small>
            </div>
          </div>

          <div class="hero-copy">
            <p class="eyebrow">— Introduction</p>
            <h2>BIM &amp;<br />Software Developer</h2>
            <p>
              I build engineering software, CAD/BIM automation and geometry-driven
              tools that turn complex design workflows into practical systems.
            </p>
            <a class="text-link" href="#story">My story <span>→</span></a>
          </div>
        </div>
      </section>

      <!-- MY STORY — horizontal -->
      <section id="story" class="section story-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 — Background</p>
            <h2>My Story</h2>
          </div>
          <span class="scroll-hint">← drag / swipe →</span>
        </div>

        <div class="horizontal-track story-track">
          <article class="story-card story-card--large">
            <span class="card-number">01</span>
            <h3>From design<br />to systems</h3>
            <p>
              My work sits between engineering design and software. I enjoy
              understanding a workflow deeply and then finding the algorithm
              that can make it faster, cleaner and more repeatable.
            </p>
          </article>

          <article class="story-card">
            <span class="card-number">02</span>
            <h3>Geometry<br />is the language</h3>
            <p>
              CAD and BIM problems often begin with points, curves, surfaces,
              intersections and constraints. I like turning those pieces into
              reliable computational geometry.
            </p>
          </article>

          <article class="story-card">
            <span class="card-number">03</span>
            <h3>Build it<br />to last</h3>
            <p>
              Clean architecture matters as much as getting the first result.
              Interfaces, services, ViewModels and testable algorithms make
              automation easier to evolve.
            </p>
          </article>

          <article class="story-card story-card--accent">
            <span class="card-number">04</span>
            <h3>What comes<br />next?</h3>
            <p>
              More intelligent design tools, better geometry engines and
              software that helps engineers spend less time repeating work.
            </p>
          </article>
        </div>
      </section>

      <!-- WORKS — horizontal -->
      <section id="works" class="section works-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 — Selected work</p>
            <h2>Works</h2>
          </div>
          <span class="scroll-hint">← drag / swipe →</span>
        </div>

        <div class="horizontal-track works-track">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-image">
                <span>{project.number}</span>
                <div class="project-image-mark">PROJECT<br />IMAGE</div>
              </div>
              <div class="project-meta">
                <span>{project.type}</span>
                <span>{project.tag}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.text}</p>
              <a href="#" class="text-link">View project <span>↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="section contact-section">
        <div class="contact-layout">
          <div>
            <p class="eyebrow">03 — Let's talk</p>
            <h2>Have a project<br /><em>in mind?</em></h2>
          </div>

          <div class="contact-details">
            <p>
              Whether it is a BIM automation problem, a CAD plugin,
              computational geometry or a software idea — let's talk.
            </p>
            <a class="big-link" href="mailto:YOUR_EMAIL@example.com">
              YOUR_EMAIL@example.com
              <span>↗</span>
            </a>
            <div class="contact-row">
              <a href="#">LinkedIn</a>
              <a href="#">GitHub</a>
              <a href="#">Download CV</a>
            </div>
          </div>
        </div>
      </section>

      <!-- BLOG — horizontal -->
      <section id="blog" class="section blog-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">04 — Notes &amp; ideas</p>
            <h2>Blog</h2>
          </div>
          <span class="scroll-hint">← drag / swipe →</span>
        </div>

        <div class="horizontal-track blog-track">
          {posts.map((post, index) => (
            <article class:list={["blog-card", index === 1 && "blog-card--merlot"]}>
              <div class="blog-top">
                <span>{post.date}</span>
                <span>{post.category}</span>
              </div>
              <div>
                <span class="card-number">0{index + 1}</span>
                <h3>{post.title}</h3>
                <p>{post.text}</p>
              </div>
              <a href="#" class="text-link">Read note <span>→</span></a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <span>YN / Portfolio</span>
      <span>Built with intention.</span>
    </footer>

    <script>
      const toggle = document.querySelector(".menu-toggle");
      const mobileNav = document.querySelector(".mobile-nav");

      toggle?.addEventListener("click", () => {
        const open = document.body.classList.toggle("menu-open");
        toggle.setAttribute("aria-expanded", String(open));
      });

      document.querySelectorAll(".mobile-nav a").forEach((link) => {
        link.addEventListener("click", () => {
          document.body.classList.remove("menu-open");
          toggle?.setAttribute("aria-expanded", "false");
        });
      });

      const sections = [...document.querySelectorAll("main > section[id]")];
      const navLinks = [...document.querySelectorAll(".desktop-nav .nav-link")];

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visible) return;
          navLinks.forEach((link) =>
            link.classList.toggle("active", link.getAttribute("href") === `#${visible.target.id}`)
          );
        },
        { threshold: [0.25, 0.5, 0.75] }
      );

      sections.forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
