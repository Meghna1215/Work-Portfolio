    </main>


    <!-- FOOTER -->
    <footer>

      <span>
        MJ / Portfolio
      </span>

      <span>
        Built with intention.
      </span>

    </footer>


    <!-- JAVASCRIPT -->
    <script>

      import Lenis from "lenis";

      // ==========================================
      // SMOOTH SCROLLING (inertia on mouse wheel / trackpad)
      // ------------------------------------------
      // lerp: lower = smoother / floatier (0.05 – 0.15 is the useful range)
      // wheelMultiplier: lower = each wheel notch scrolls less distance
      // Touch screens keep their native scrolling.
      // ==========================================

      const reduceMotion =
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        new Lenis({
          autoRaf: true,
          lerp: 0.08,
          wheelMultiplier: 0.8,
          anchors: true
        });
      }


      // "View Project" buttons that still point to "#" do nothing for now
      document
        .querySelectorAll('.live-project-btn[href="#"]')
        .forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
          });
        });


      // ==========================================
      // MOBILE HAMBURGER MENU
      // ==========================================

      const toggle = document.querySelector(".menu-toggle");

      toggle?.addEventListener("click", () => {

        const isOpen =
          document.body.classList.toggle("menu-open");

        toggle.setAttribute(
          "aria-expanded",
          String(isOpen)
        );

        toggle.setAttribute(
          "aria-label",
          isOpen
            ? "Close navigation"
            : "Open navigation"
        );

      });


      // ==========================================
      // CLOSE MOBILE MENU WHEN LINK IS CLICKED
      // ==========================================

      document
        .querySelectorAll(".mobile-nav a")
        .forEach((link) => {

          link.addEventListener("click", () => {

            document.body.classList.remove(
              "menu-open"
            );

            toggle?.setAttribute(
              "aria-expanded",
              "false"
            );

            toggle?.setAttribute(
              "aria-label",
              "Open navigation"
            );

          });

        });


      // ==========================================
      // DESKTOP NAVIGATION ACTIVE SECTION
      // ------------------------------------------
      // Highlights the menu link of whichever section is under a line
      // 40% of the way down the screen. (Works for tall sections like Skills.)
      // ==========================================

      const sections = [
        ...document.querySelectorAll(
          "main > section[id]"
        )
      ];

      const navLinks = [
        ...document.querySelectorAll(
          ".desktop-nav .nav-link"
        )
      ];

      // sections that don't have their own menu link use another link
      const navTarget = {
        story: "home"
      };

      function updateActiveNav() {

        const line = window.innerHeight * 0.4;

        let current = sections[0];

        sections.forEach((section) => {
          if (section.getBoundingClientRect().top <= line) {
            current = section;
          }
        });

        const target = navTarget[current.id] ?? current.id;

        navLinks.forEach((link) => {
          link.classList.toggle(
            "active",
            link.getAttribute("href") === `#${target}`
          );
        });

      }

      let navTicking = false;

      window.addEventListener(
        "scroll",
        () => {
          if (navTicking) return;
          navTicking = true;
          requestAnimationFrame(() => {
            updateActiveNav();
            navTicking = false;
          });
        },
        { passive: true }
      );

      window.addEventListener("resize", updateActiveNav);

      updateActiveNav();


      // ==========================================
      // HERO ANIMATION
      // ==========================================

      const heroElements =
        document.querySelectorAll(
          ".slide-from-left, .slide-from-right, .fade-zoom-in"
        );


      const heroSection =
        document.querySelector("#home");


      if (heroSection) {

        const heroObserver =
          new IntersectionObserver(

            (entries) => {

              entries.forEach((entry) => {

                if (entry.isIntersecting) {

                  // Play animation
                  heroElements.forEach((el) => {

                    el.classList.add(
                      "animate"
                    );

                  });

                } else {

                  // Reset animation
                  heroElements.forEach((el) => {

                    el.classList.remove(
                      "animate"
                    );

                  });

                }

              });

            },

            {
              threshold: 0.3
            }

          );


        heroObserver.observe(
          heroSection
        );

      }

    </script>

  </body>
</html>