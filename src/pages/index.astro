import "../styles/global.css";

// Works whether your configured base ends with a slash or not.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ------------------------------------------------------------
// Placeholder visuals (inline SVG) for each project card.
// To use real screenshots instead, add an `images` array to a
// project: images: ["/Work-Portfolio/revit-1.webp", "...-2.webp", "...-3.webp"]
// Order = [small top, small bottom, large right].
// ------------------------------------------------------------
const wrap = (bg: string, inner: string) =>
  `<svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="400" height="260" fill="${bg}"/>${inner}</svg>`;
const line = `fill="none" stroke="#E6E0D6" stroke-opacity=".55" stroke-width="1.5"`;
const faint = `stroke="#E6E0D6" stroke-opacity=".25" stroke-width="1"`;
const gold = `fill="none" stroke="#C89B4A" stroke-opacity=".85" stroke-width="1.6"`;
const diamond = (y: number) => `<path d="M200 ${y} L320 ${y + 45} L200 ${y + 90} L80 ${y + 45} Z"/>`;
const win = (x: number, y: number) => `<rect x="${x}" y="${y}" width="22" height="26"/>`;

// ------------------------------------------------------------
// One card per skill. Edit the text freely.
//  - `href`  : link for the "View Project" button (leave out for now = "#")
//  - `images`: optional real screenshots, in the order
//              [small top, small bottom, large right]
// ------------------------------------------------------------
const skills = [
  {
    number: "01",
    title: "Model",
    text: "Building coordinated, data-rich BIM models for complex infrastructure projects, from concept through to detailed design.",
    href: `${base}/model/`,   // opens the interactive 3D page (src/pages/model.astro)
    images: [] as string[],
    visuals: [
      wrap("#4B1E23", `<g ${line}><path d="M110 170 L200 205 L290 170 V90 L200 125 L110 90 Z"/><path d="M200 125 V205"/><path d="M110 90 L200 55 L290 90"/></g>`),
      wrap("#3a171b", `<g ${line}><rect x="90" y="50" width="220" height="160"/><path d="M90 103 H310 M90 157 H310 M163 50 V210 M237 50 V210"/></g><rect x="163" y="103" width="74" height="54" fill="#C89B4A" fill-opacity=".7"/>`),
      wrap("#4B1E23", `<g ${line}><path d="M90 190 L200 235 L310 190 V120 L200 165 L90 120 Z"/><path d="M200 165 V235"/><path d="M90 120 L200 75 L310 120"/><path d="M130 105 L200 77 L270 105 V60 L200 30 L130 60 Z"/></g><g fill="#C89B4A"><circle cx="200" cy="165" r="4"/><circle cx="200" cy="75" r="4"/><circle cx="310" cy="120" r="4"/><circle cx="90" cy="120" r="4"/></g>`)
    ]
  },
  {
    number: "02",
    title: "Coordinate",
    text: "Aligning architecture, structure and services in one federated model, finding clashes early and resolving them before site.",
    href: "#",
    images: [] as string[],
    visuals: [
      wrap("#6B6F4E", `<g ${line}><rect x="90" y="70" width="150" height="110"/><rect x="160" y="110" width="150" height="110"/></g><rect x="160" y="110" width="80" height="70" fill="#C89B4A" fill-opacity=".8"/>`),
      wrap("#5b5f41", `<path d="M70 130 H330" stroke="#E6E0D6" stroke-opacity=".4" stroke-width="12"/><path d="M200 40 V220" stroke="#E6E0D6" stroke-opacity=".4" stroke-width="12"/><circle cx="200" cy="130" r="22" fill="none" stroke="#C89B4A" stroke-width="2.5"/>`),
      wrap("#6B6F4E", `<g ${line}>${diamond(20)}${diamond(75)}${diamond(130)}</g><path d="M200 65 V175" stroke="#E6E0D6" stroke-opacity=".5" stroke-dasharray="4 5"/><g fill="#C89B4A"><circle cx="200" cy="65" r="5"/><circle cx="200" cy="120" r="5"/><circle cx="200" cy="175" r="5"/></g>`)
    ]
  },
  {
    number: "03",
    title: "Collaborate",
    text: "Keeping every discipline on the same page with clear BIM standards, shared workflows and regular model reviews.",
    href: "#",
    images: [] as string[],
    visuals: [
      wrap("#1C2430", `<g ${line}><path d="M200 60 L130 170 L270 170 Z"/><circle cx="200" cy="60" r="14" fill="#1C2430"/><circle cx="130" cy="170" r="14" fill="#1C2430"/><circle cx="270" cy="170" r="14" fill="#1C2430"/></g><circle cx="200" cy="60" r="6" fill="#C89B4A"/>`),
      wrap("#232d3b", `<g ${line}><circle cx="170" cy="130" r="55"/><circle cx="230" cy="130" r="55"/></g><circle cx="200" cy="130" r="6" fill="#C89B4A"/>`),
      wrap("#1C2430", `<g ${line}><path d="M200 130 L310 130 M200 130 L255 195 M200 130 L145 195 M200 130 L90 130 M200 130 L145 65 M200 130 L255 65"/><circle cx="310" cy="130" r="13" fill="#1C2430"/><circle cx="255" cy="195" r="13" fill="#1C2430"/><circle cx="145" cy="195" r="13" fill="#1C2430"/><circle cx="90" cy="130" r="13" fill="#1C2430"/><circle cx="145" cy="65" r="13" fill="#1C2430"/><circle cx="255" cy="65" r="13" fill="#1C2430"/></g><circle cx="200" cy="130" r="18" fill="#C89B4A"/>`)
    ]
  },
  {
    number: "04",
    title: "Visualize",
    text: "Turning model data into clear views, sections and visuals that help clients and teams understand the design.",
    href: "#",
    images: [] as string[],
    visuals: [
      wrap("#8A5A2B", `<g ${line}><path d="M80 130 Q200 40 320 130 Q200 220 80 130 Z"/><circle cx="200" cy="130" r="30"/></g><circle cx="200" cy="130" r="11" fill="#C89B4A"/>`),
      wrap("#7a4f26", `<g ${line}><rect x="110" y="55" width="180" height="150"/><path d="M80 205 H320"/></g><g fill="#E6E0D6" fill-opacity=".45">${win(130, 75)}${win(189, 75)}${win(248, 75)}${win(130, 120)}${win(189, 120)}${win(248, 120)}</g><rect x="189" y="165" width="22" height="40" fill="#C89B4A" fill-opacity=".85"/>`),
      wrap("#8A5A2B", `<g ${line}><rect x="50" y="35" width="300" height="190" rx="6"/><path d="M50 200 H350"/><rect x="110" y="110" width="50" height="90"/><rect x="170" y="80" width="60" height="120"/><rect x="240" y="130" width="45" height="70"/></g><circle cx="305" cy="80" r="18" fill="#C89B4A"/>`)
    ]
  },
  {
    number: "05",
    title: "Automate",
    text: "Cutting repetitive modelling work with Revit API, C# and Python tools that make delivery faster and more repeatable.",
    href: "#",
    images: [] as string[],
    visuals: [
      wrap("#1d1b19", `<g ${gold}><path d="M150 90 L100 130 L150 170 M250 90 L300 130 L250 170 M220 80 L180 180"/></g>`),
      wrap("#262320", `<g ${gold}><circle cx="200" cy="130" r="38"/><circle cx="200" cy="130" r="14"/></g><g stroke="#C89B4A" stroke-opacity=".85" stroke-width="9"><path d="M238 130 H252 M226.9 156.9 L236.8 166.8 M200 168 V182 M173.1 156.9 L163.2 166.8 M162 130 H148 M173.1 103.1 L163.2 93.2 M200 92 V78 M226.9 103.1 L236.8 93.2"/></g>`),
      wrap("#1d1b19", `<g ${gold}><rect x="30" y="100" width="90" height="60" rx="6"/><rect x="155" y="100" width="90" height="60" rx="6"/><rect x="280" y="100" width="90" height="60" rx="6"/><path d="M120 130 H155 M245 130 H280 M147 123 L155 130 L147 137 M272 123 L280 130 L272 137"/></g><g fill="#C89B4A" fill-opacity=".35"><rect x="30" y="176" width="90" height="6"/><rect x="155" y="176" width="90" height="6"/></g><rect x="280" y="176" width="90" height="6" fill="#C89B4A"/>`)
    ]
  }
];
